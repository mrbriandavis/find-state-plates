<header class="border-b border-zinc-100 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-6xl items-center justify-between py-4 text-sm">
    <div class="flex items-center gap-3">
      <.link navigate={~p"/"} class="text-lg font-semibold text-zinc-900">Find State Plates</.link>
      <span class="rounded-full bg-zinc-100 px-2 py-1 text-xs font-semibold text-zinc-600">Phoenix LiveView</span>
    </div>
    <nav class="flex items-center gap-4 font-semibold text-zinc-700">
      <%= if @current_user do %>
        <span class="hidden text-zinc-500 sm:inline"><%= @current_user.email %></span>
        <.link navigate={~p"/trips"} class="hover:text-zinc-900">My trips</.link>
        <.link href={~p"/users/log_out"} method="delete" class="rounded-lg bg-zinc-900 px-3 py-2 text-white hover:bg-zinc-700">
          Log out
        </.link>
      <% else %>
        <.link navigate={~p"/users/log_in"} class="hover:text-zinc-900">Log in</.link>
        <.link navigate={~p"/users/register"} class="rounded-lg bg-zinc-900 px-3 py-2 text-white hover:bg-zinc-700">
          Register
        </.link>
      <% end %>
    </nav>
  </div>
</header>
<main class="px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
